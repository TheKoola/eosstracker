                <Placemark id="30">
                    <name>17k, Laminar-to-Turbulent</name>
                    <description><![CDATA[
        <h1>Airflow Transitioning from Laminar-to-Turbulent</h1>
        <table style="width: 100%;" cellpadding=0 cellspacing=0 border=0>
